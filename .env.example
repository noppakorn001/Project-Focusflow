# Firebase Configuration
# Get these from: Firebase Console → Project Settings → Your apps → Web app → Config
# All values are NEXT_PUBLIC_ because Firebase Auth runs entirely on the client.

NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# ── Firebase Setup Steps ────────────────────────────────────────────────────
# 1. Go to https://console.firebase.google.com/ and create (or open) a project.
# 2. Authentication → Sign-in method → Enable "Google".
# 3. Firestore Database → Create database → Production mode → choose a region.
# 4. Firestore → Rules → paste the security rules below → Publish.
# 5. Project Settings → Your apps → Add web app → copy the config object above.
# 6. Copy this file to .env.local and fill in your values.
#
# Firestore Security Rules:
# ─────────────────────────
# rules_version = '2';
# service cloud.firestore {
#   match /databases/{database}/documents {
#     match /users/{userId}/data/{document} {
#       allow read, write: if request.auth != null && request.auth.uid == userId;
#     }
#   }
# }
