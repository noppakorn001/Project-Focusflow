# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this in Vercel Dashboard → Settings → Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The deployment URL of your app.
# For Vercel, use the primary domain (e.g., https://your-app.vercel.app).
# This is used for OAuth callbacks and postMessage origin validation.
APP_URL="MY_APP_URL"

# Google OAuth Credentials
# Obtain these from the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Steps:
# 1. Enable the Google Drive API and Google Calendar API.
# 2. Create OAuth 2.0 Client credentials.
# 3. Add the redirect URI: <APP_URL>/api/auth/callback
# 4. Set these values in Vercel Dashboard → Settings → Environment Variables.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
